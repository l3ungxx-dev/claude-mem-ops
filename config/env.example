# claude-mem-ops environment (install.sh copies this to ~/.config/claude-mem-ops/env)
# Required for consolidation: DeepSeek (or any OpenAI-compatible) API key
DEEPSEEK_API_KEY=

# Optional overrides
# MEMORY_ROOT=$HOME/claude-mem-ops/docs/memory
# CLAUDE_MEM_DB=$HOME/.claude-mem/claude-mem.db
# CONSOLIDATE_API_BASE=https://api.deepseek.com/v1
# CONSOLIDATE_MODEL=deepseek-flash
# CLOUD_ROUTER_MONITOR=$HOME/claude-mem-ops/docs/memory/.monitor/cloud-router.md
